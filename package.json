{
  "name": "node-mkcert-binary",
  "type": "module",
  "version": "3.0.1",
  "description": "Downloads the Mkcert binary for use in npx scripts",
  "author": "Ian Baron",
  "license": "MIT",
  "homepage": "https://github.com/uvmain/node-mkcert-binary#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uvmain/node-mkcert-binary.git"
  },
  "bugs": {
    "url": "https://github.com/uvmain/node-mkcert-binary/issues"
  },
  "keywords": [
    "mkcert",
    "ssl",
    "certificate",
    "tls"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mkcert": "./mkcert"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "postinstall": "node dist/index.js",
    "lint": "eslint",
    "build": "tsc -p .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.2",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "typescript": "^5.9.3"
  }
}
